# Template for .env.local — fill in your own values, never share this file once filled.
# Copy with:  cp .env.example .env.local

# --- Required ------------------------------------------------------------
# Your sign-in code for the app (pick your own, at least 12 characters).
APP_ACCESS_CODE=

# Anthropic API for the AI role-plays: console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# --- Optional ------------------------------------------------------------
# Postgres so your progress syncs across devices: neon.tech -> connection string
DATABASE_URL=

# Azure Speech for pronunciation scoring and generating new audio: portal.azure.com
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# A second code you can hand to other people. That progress resets every night.
DEMO_ACCESS_CODE=

# Push reminders (Claude generates this key pair, see SETUP.md step 2)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Protects the two cron jobs defined in vercel.json (32 random characters)
CRON_SECRET=

# Daily limits for role-play messages (defaults: 30 and 20)
ROLEPLAY_DAILY_LIMIT=
DEMO_ROLEPLAY_DAILY_LIMIT=
